{
  "name": "@yossyi0323/flexible-calendar",
  "version": "0.1.0",
  "description": "Framework-independent TypeScript calendar with native date × resource columns",
  "type": "module",
  "license": "MIT",
  "repository": "github:yossyi0323/flexible-calendar",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs",
    "src"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./dom": {
      "types": "./dist/dom/index.d.ts",
      "import": "./dist/dom/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/dom/style.css dist/style.css",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dev": "vite --host 127.0.0.1",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:package": "publint && attw --pack --profile esm-only --exclude-entrypoints ./style.css && node scripts/smoke-package.mjs",
    "bench": "node scripts/benchmark.mjs"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.66.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^4.0.4",
    "vue": "^3.5.22"
  },
  "private": true,
  "engines": {
    "node": ">=20.19"
  }
}
